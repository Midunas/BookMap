# Supabase project settings: dashboard > Project Settings > API keys
# https://supabase.com/dashboard/project/_/settings/api-keys

# Project URL: dashboard > Project Settings > API > Project URL
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable/anon key: dashboard > Project Settings > API keys > "anon" / "publishable" key
NUXT_PUBLIC_SUPABASE_KEY=your-anon-key

# Secret key: dashboard > Project Settings > API keys > "service_role" / "secret" key (sb_secret_...)
# Server-only. Never expose this to the client.
NUXT_SUPABASE_SECRET_KEY=your-secret-key
